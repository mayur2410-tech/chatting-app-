# Copy to backend/.env. Never commit the real file.

# development | production | test  (API docs at /api/docs only in development)
ENVIRONMENT=development

# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in the root .env
DATABASE_URL=postgresql+psycopg://duo:change-me-to-a-long-random-value@127.0.0.1:5432/duo
TEST_DATABASE_URL=postgresql+psycopg://duo:change-me-to-a-long-random-value@127.0.0.1:5432/duo_test

# 64+ random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-output-of-the-command-above

# Comma-separated. Origins are full scheme://host[:port]; hosts are bare hostnames.
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# false only for plain-http local development. Production (HTTPS) must use true,
# which also switches the cookie name to the __Host- prefixed form.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

SESSION_TTL_MINUTES=720
SESSION_IDLE_MINUTES=60

# Keep true for anything reachable from the internet (protects short passwords from guessing).
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILURES_PER_USER=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_SECONDS=900

MESSAGE_RATE_LIMIT=30
MESSAGE_RATE_WINDOW_SECONDS=60
# How often open WebSockets re-validate their session (seconds).
WS_AUTH_RECHECK_SECONDS=30

# Shortest allowed account password. 12+ recommended.
MIN_PASSWORD_LENGTH=12

# Database connection pool (hosted databases limit connections; Aiven free = 15).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Folder with the built website; when set, the API serves the site too (used in the Docker image).
# STATIC_DIR=../frontend/dist
